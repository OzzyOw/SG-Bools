<%
  const v = (k) => form[k] ?? '';
  const sel = (k, val) => (form[k] === val ? 'selected' : '');
  const chk = (k, val) => (form[k] === val ? 'checked' : '');
%>
<% if (errors.length) { %>
  <div class="flash flash-err"><% errors.forEach(e => { %><div><%= e %></div><% }) %></div>
<% } %>
<div class="field">
  <label for="bet_type">Bet type</label>
  <select id="bet_type" name="bet_type">
    <option value="1X2" <%= sel('bet_type', '1X2') %>>1X2 (win / draw / win)</option>
    <option value="AH" <%= sel('bet_type', 'AH') %>>Asian Handicap</option>
    <option value="OU" <%= sel('bet_type', 'OU') %>>Total Goals Over/Under</option>
    <option value="CS" <%= sel('bet_type', 'CS') %>>Correct Score</option>
    <option value="OTHER" <%= sel('bet_type', 'OTHER') %>>Other</option>
  </select>
</div>

<fieldset class="field bt bt-1X2">
  <legend>Pick</legend>
  <label class="chip"><input type="radio" name="pick_1x2" value="HOME" <%= chk('pick_1x2', 'HOME') %>> <%= match.home_team %></label>
  <label class="chip"><input type="radio" name="pick_1x2" value="DRAW" <%= chk('pick_1x2', 'DRAW') %>> Draw</label>
  <label class="chip"><input type="radio" name="pick_1x2" value="AWAY" <%= chk('pick_1x2', 'AWAY') %>> <%= match.away_team %></label>
</fieldset>

<fieldset class="field bt bt-AH">
  <legend>Team and handicap</legend>
  <label class="chip"><input type="radio" name="pick_ah" value="HOME" <%= chk('pick_ah', 'HOME') %>> <%= match.home_team %></label>
  <label class="chip"><input type="radio" name="pick_ah" value="AWAY" <%= chk('pick_ah', 'AWAY') %>> <%= match.away_team %></label>
  <input class="short" name="line_ah" inputmode="decimal" placeholder="e.g. -1.5 or +0.25" value="<%= v('line_ah') %>">
</fieldset>

<fieldset class="field bt bt-OU">
  <legend>Over / Under total goals</legend>
  <label class="chip"><input type="radio" name="pick_ou" value="OVER" <%= chk('pick_ou', 'OVER') %>> Over</label>
  <label class="chip"><input type="radio" name="pick_ou" value="UNDER" <%= chk('pick_ou', 'UNDER') %>> Under</label>
  <input class="short" name="line_ou" inputmode="decimal" placeholder="e.g. 2.5 or 2.75" value="<%= v('line_ou') %>">
</fieldset>

<fieldset class="field bt bt-CS">
  <legend>Score (90 minutes)</legend>
  <span class="cs"><%= match.home_team %> <input class="tiny" name="cs_home" inputmode="numeric" value="<%= v('cs_home') %>">
  – <input class="tiny" name="cs_away" inputmode="numeric" value="<%= v('cs_away') %>"> <%= match.away_team %></span>
</fieldset>

<div class="field bt bt-OTHER">
  <label for="other_text">What's the bet?</label>
  <input id="other_text" name="other_text" maxlength="100" placeholder="e.g. Saka to score anytime" value="<%= v('other_text') %>">
  <small>You settle "Other" bets yourself after the match.</small>
</div>

<div class="row">
  <div class="field">
    <label for="odds">Odds</label>
    <input id="odds" name="odds" inputmode="decimal" placeholder="2.10" value="<%= v('odds') %>">
  </div>
  <div class="field">
    <label for="stake">Stake (SGD)</label>
    <input id="stake" name="stake" inputmode="decimal" placeholder="10.00" value="<%= v('stake') %>">
  </div>
</div>
<div class="field">
  <label for="description">Why? <small>(optional)</small></label>
  <textarea id="description" name="description" maxlength="500" rows="2"><%= v('description') %></textarea>
</div>
<script>
  (function () {
    var s = document.getElementById('bet_type');
    function show() {
      document.querySelectorAll('.bt').forEach(function (el) {
        el.hidden = !el.classList.contains('bt-' + s.value);
      });
    }
    s.addEventListener('change', show);
    show();
  })();
</script>
